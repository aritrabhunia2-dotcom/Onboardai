# Google Gemini API key (Required for AI Chatpot & Codebase Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive API key (Optional - for fetching Drive file metadata)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# GitHub Personal Access Token (Optional - increases rate limits from 60 to 5000 req/hr)
# GITHUB_TOKEN=your_github_token_here

# Backend port
PORT=5000
